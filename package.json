{
  "name": "snapvector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rough loop in, clean SVG cutout out. 100% client-side.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "shots": "node scripts/screenshot.mjs",
    "a11y": "node scripts/a11y.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "onnxruntime-web": "^1.30.0"
  }
}
